PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/database
BASE_URL=http://localhost:3000
WEBSOCKET_NAMESPACE=/notice

# Use a cryptographically random value with at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# Required only when running the initial database seed.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT=10
DB_IDLE_TIMEOUT=300

# 登录验证码开关(默认 true;本地/测试环境可设 false 关闭)
LOGIN_CAPTCHA_ENABLED=true
